.checkin {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
}
.streak-num {
  font-size: 72rpx;
  font-weight: 700;
  color: #b23a33;
  line-height: 1.1;
  text-align: center;
}
.week {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0 12rpx;
}
.day {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 1rpx solid #d8cfb8;
  display: flex;
  align-items: center;
  justify-content: center;
}
.day.done {
  background-color: #b23a33;
  border-color: #b23a33;
}
.total {
  margin-top: 6rpx;
}

.stats {
  display: flex;
  justify-content: space-around;
  text-align: center;
  margin-top: 24rpx;
}
.stat {
  flex: 1;
}
.stat-num {
  font-size: 52rpx;
  font-weight: 700;
  color: #b23a33;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}
.actions .btn {
  flex: 1;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.chip {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #fdfbf5;
  border: 1rpx solid #e7e0d0;
  border-radius: 16rpx;
  font-size: 48rpx;
  font-family: "Songti SC", serif;
}

.records {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}
.record {
  flex: 1;
  min-width: 140rpx;
  padding: 24rpx;
  background-color: #fdfbf5;
  border: 1rpx solid #e7e0d0;
  border-radius: 16rpx;
  text-align: center;
}
.record-char {
  font-size: 56rpx;
  font-family: "Songti SC", serif;
}

.empty {
  padding: 30rpx 0;
}

.btn.ghost {
  margin-top: 28rpx;
}
