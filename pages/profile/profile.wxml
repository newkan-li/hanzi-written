<view class="page">
  <view class="checkin card">
    <view class="streak">
      <view class="streak-num">{{checkin.streak}}</view>
      <view class="muted">连续打卡（天）</view>
    </view>
    <view class="week">
      <view class="day {{item.done ? 'done' : ''}}" wx:for="{{checkin.recent}}" wx:key="date">
        <view class="dot"></view>
      </view>
    </view>
    <view class="muted total">累计打卡 {{checkin.totalDays}} 天</view>
  </view>

  <view class="remind card">
    <view class="remind-row">
      <view>
        <view class="remind-title">打卡提醒</view>
        <view class="muted">{{remindOn ? '已开启 · 每天 ' + remindTime : '开启后每天提醒练字'}}</view>
      </view>
      <switch checked="{{remindOn}}" color="#b23a33" bindchange="toggleRemind" />
    </view>
    <view class="remind-row" wx:if="{{remindOn}}">
      <text class="muted">提醒时间</text>
      <picker mode="time" value="{{remindTime}}" bindchange="onRemindTime">
        <view class="time-val">{{remindTime}}</view>
      </picker>
    </view>
    <view class="muted remind-note" wx:if="{{!tmplReady}}">提醒需在 config 配置订阅模板，并由服务端定时发送</view>
  </view>

  <view class="stats card">
    <view class="stat">
      <view class="stat-num">{{stats.charCount}}</view>
      <view class="muted">已练字数</view>
    </view>
    <view class="stat">
      <view class="stat-num">{{stats.totalCount}}</view>
      <view class="muted">练习次数</view>
    </view>
    <view class="stat">
      <view class="stat-num">{{stats.favCount}}</view>
      <view class="muted">收藏</view>
    </view>
  </view>

  <view class="actions">
    <view class="btn" bindtap="onMakePoster">生成练习海报</view>
    <view class="btn ghost" bindtap="onMakeWorksheet">收藏生成字帖</view>
  </view>
  <view class="btn ghost block weak-entry" bindtap="onOpenWeak">
    生字本（{{stats.weakCount}}）
  </view>
  <view class="btn ghost block weak-entry" bindtap="onOpenTraj">练习轨迹</view>
  <view class="btn ghost block weak-entry" bindtap="onOpenAbout">关于与隐私</view>

  <view class="section-title">我的收藏</view>
  <view class="chips" wx:if="{{favorites.length}}">
    <view
      class="chip"
      wx:for="{{favorites}}"
      wx:key="*this"
      data-char="{{item}}"
      bindtap="onTapChar"
    >{{item}}</view>
  </view>
  <view class="muted empty" wx:else>还没有收藏，去字库挑几个字吧</view>
  <view class="fav-actions" wx:if="{{favorites.length}}">
    <view class="btn" bindtap="onPracticeFavorites">练习全部收藏</view>
    <view class="btn ghost" bindtap="onClearFavorites">清空收藏</view>
  </view>

  <view class="section-title">最近练习</view>
  <view class="records" wx:if="{{records.length}}">
    <view
      class="record"
      wx:for="{{records}}"
      wx:key="char"
      data-char="{{item.char}}"
      bindtap="onTapChar"
    >
      <view class="record-char">{{item.char}}</view>
      <view class="muted">练了 {{item.count}} 次</view>
    </view>
  </view>
  <view class="muted empty" wx:else>还没有练习记录</view>
  <view class="btn ghost" wx:if="{{records.length}}" bindtap="onClearRecords">清空记录</view>
</view>
