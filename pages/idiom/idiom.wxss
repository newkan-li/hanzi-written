.search {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 24rpx;
}
.search-input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  background-color: #f4efe3;
  border-radius: 38rpx;
  font-size: 28rpx;
}

.idioms {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.idiom {
  padding: 28rpx 32rpx;
}
.idiom-word {
  font-size: 44rpx;
  font-family: "Songti SC", serif;
  letter-spacing: 6rpx;
}
.idiom-pinyin {
  color: #b23a33;
  font-size: 24rpx;
  margin: 8rpx 0;
}
.idiom-meaning {
  font-size: 26rpx;
}
.empty {
  text-align: center;
  padding: 40rpx 0;
}
