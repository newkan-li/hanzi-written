<view class="page">
  <view class="section-title">字帖来源</view>
  <view class="chips">
    <view
      class="chip {{source === item.key ? 'active' : ''}}"
      wx:for="{{sources}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="pickSource"
    >{{item.name}}</view>
  </view>

  <view wx:if="{{source === 'template'}}" class="tpl-list">
    <view
      class="tpl {{templateIndex === index ? 'active' : ''}}"
      wx:for="{{templates}}"
      wx:key="key"
      data-index="{{index}}"
      bindtap="pickTemplate"
    >
      <view class="tpl-name">{{item.name}}</view>
      <view class="tpl-desc">{{item.desc}}</view>
    </view>
  </view>

  <textarea
    wx:if="{{source === 'custom'}}"
    class="custom-input"
    placeholder="单行=字表（如 永和静学）；多行=每行一句，可排诗句，空行留白"
    value="{{customText}}"
    bindinput="onCustom"
    maxlength="300"
  />

  <view class="section-title">格子样式</view>
  <view class="chips">
    <view
      class="chip {{gridStyle === item.key ? 'active' : ''}}"
      wx:for="{{grids}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="pickGrid"
    >{{item.name}}</view>
  </view>

  <view class="section-title">排版</view>
  <view class="chips">
    <view class="chip {{layout === 'grid' ? 'active' : ''}}" data-key="grid" bindtap="pickLayout">字表排版</view>
    <view
      wx:if="{{poem}}"
      class="chip {{layout === 'poem' ? 'active' : ''}}"
      data-key="poem"
      bindtap="pickLayout"
    >诗句排版</view>
  </view>

  <view class="poem-tip muted" wx:if="{{poem}}">{{poem.title}}<text wx:if="{{poem.dynasty}}"> · {{poem.dynasty}} {{poem.author}}</text></view>

  <view class="opt-row">
    <text class="opt-label">纸张</text>
    <view class="chips">
      <view
        class="chip sm {{orientation === item.key ? 'active' : ''}}"
        wx:for="{{orientations}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="pickOrientation"
      >{{item.name}}</view>
    </view>
  </view>

  <view class="opt-row">
    <text class="opt-label">格子大小</text>
    <view class="chips">
      <view
        class="chip sm {{cellCm === item.key ? 'active' : ''}}"
        wx:for="{{cellOptions}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="pickCell"
      >{{item.name}}</view>
    </view>
  </view>

  <view class="opt-row" wx:if="{{layout === 'grid'}}">
    <text class="opt-label">每字重复</text>
    <view class="chips">
      <view
        class="chip sm {{repeat === item.key ? 'active' : ''}}"
        wx:for="{{repeatOptions}}"
        wx:key="key"
        data-value="{{item.key}}"
        bindtap="pickRepeat"
      >{{item.name}}</view>
    </view>
  </view>

  <view class="opt-row" wx:if="{{layout === 'poem'}}">
    <text class="opt-label">描红行</text>
    <view class="chips">
      <view
        class="chip sm {{traceRows === item ? 'active' : ''}}"
        wx:for="{{traceOptions}}"
        wx:key="*this"
        data-value="{{item}}"
        bindtap="pickTrace"
      >{{item}}</view>
    </view>
  </view>

  <view class="section-title">页眉</view>
  <input
    class="footer-input"
    placeholder="页眉标题（默认按内容自动）"
    value="{{headerTitle}}"
    bindinput="onTitleInput"
    maxlength="20"
  />
  <view class="opt-row">
    <text class="opt-label">日期</text>
    <view class="chips">
      <view class="chip sm {{showDate ? 'active' : ''}}" bindtap="toggleDate">{{showDate ? '显示' : '隐藏'}}</view>
    </view>
  </view>

  <view class="section-title">署名 / 版权</view>
  <input
    class="footer-input"
    placeholder="如：XX小学 · 王老师 编制（可选）"
    value="{{footerText}}"
    bindinput="onFooterInput"
    maxlength="20"
  />
  <view class="opt-row">
    <text class="opt-label">水印</text>
    <view class="chips">
      <view class="chip sm {{watermark ? 'active' : ''}}" bindtap="toggleWatermark">{{watermark ? '开' : '关'}}</view>
    </view>
  </view>
  <view class="opt-row">
    <text class="opt-label">二维码</text>
    <view class="chips">
      <view class="chip sm {{qrOn ? 'active' : ''}}" bindtap="toggleQR">{{qrOn ? '开' : '关'}}</view>
      <text class="muted qr-hint">码内容＝署名文字（可填链接）</text>
    </view>
  </view>

  <view class="muted count">A4（300dpi）· 共 {{chars.length}} 个不重复汉字 · 打印选「实际大小」</view>

  <view class="btn block" bindtap="generate">生成字帖</view>

  <canvas
    type="2d"
    id="worksheet-canvas"
    class="worksheet-canvas"
    style="width: {{canvasW}}px; height: {{canvasH}}px;"
  ></canvas>

  <view class="preview-actions" wx:if="{{generated}}">
    <view class="btn ghost" bindtap="saveToAlbum">保存到相册</view>
    <view class="btn ghost" bindtap="shareImage">分享图片</view>
  </view>
</view>
