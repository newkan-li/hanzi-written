.poster {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.poster-canvas {
  display: block;
  margin: 24rpx auto 0;
  border-radius: 12rpx;
}
.poster-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
  width: 100%;
  box-sizing: border-box;
}
.poster-actions .btn {
  flex: 1;
}
