.books {
  white-space: nowrap;
  margin-bottom: 16rpx;
}
.book {
  display: inline-block;
  padding: 14rpx 30rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  border: 1rpx solid #d8cfb8;
  background-color: #fdfbf5;
  color: #8a8578;
  font-size: 26rpx;
}
.book.active {
  border-color: #b23a33;
  background-color: #b23a33;
  color: #fff;
}
.book-meta {
  margin-bottom: 20rpx;
}
.book-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.tabs {
  display: flex;
  margin: 8rpx 0 24rpx;
  border: 1rpx solid #e7e0d0;
  border-radius: 40rpx;
  overflow: hidden;
  background-color: #fdfbf5;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #8a8578;
}
.tab.active {
  background-color: #b23a33;
  color: #fff;
}

.unit {
  margin-bottom: 24rpx;
}
.unit-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.unit-theme {
  margin-left: 12rpx;
  color: #8a8578;
  font-size: 22rpx;
  font-weight: 400;
}
.unit-actions {
  float: right;
  font-weight: 400;
}
.unit-act {
  color: #b23a33;
  font-size: 24rpx;
  margin-left: 20rpx;
}
.lessons {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.lesson {
  padding: 12rpx 26rpx;
  border-radius: 12rpx;
  border: 1rpx solid #e7e0d0;
  background-color: #fdfbf5;
  color: #2b2b2b;
  font-size: 26rpx;
}
.lesson.active {
  border-color: #b23a33;
  color: #b23a33;
}

.detail {
  margin-top: 24rpx;
}
.detail-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.detail-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-right: 16rpx;
}
.chars {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}
.c {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  border: 1rpx solid #e7e0d0;
  background-color: #fff;
  font-size: 46rpx;
  font-family: "Songti SC", serif;
}
.none {
  padding: 16rpx 0;
}
.words {
  margin-top: 24rpx;
}
.words-label {
  margin-bottom: 12rpx;
}
.word {
  display: inline-block;
  padding: 8rpx 24rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 24rpx;
  background-color: #f4efe3;
  color: #b23a33;
  font-size: 28rpx;
}
.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}
.actions .btn {
  flex: 1;
}
