<view class="page">
  <view class="due card" wx:if="{{dueCount}}">
    <view>
      <view class="due-num">{{dueCount}}</view>
      <view class="muted">个生字今天待复习</view>
    </view>
    <view class="btn" bindtap="onPracticeDue">今日复习</view>
  </view>

  <view class="muted tip">在「描红 / 测验」中写错的字会自动收进生字本；答对后按间隔（1/2/4/7/15/30 天）安排下次复习。</view>

  <view class="chars" wx:if="{{list.length}}">
    <view
      class="char-card {{item.due ? 'due' : ''}}"
      wx:for="{{list}}"
      wx:key="char"
      data-char="{{item.char}}"
      bindtap="onTapChar"
    >
      <view class="char">{{item.char}}</view>
      <view class="muted cnt">Lv{{item.level}}{{item.due ? ' · 待复习' : ''}}</view>
      <view class="del" catchtap="onRemove" data-char="{{item.char}}">×</view>
    </view>
  </view>
  <view class="muted empty" wx:else>生字本是空的，去练几个字吧</view>

  <view class="actions" wx:if="{{list.length}}">
    <view class="btn" bindtap="onPracticeAll">全部练习</view>
    <view class="btn ghost" bindtap="onClear">清空</view>
  </view>
</view>
