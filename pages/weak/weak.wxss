.tip {
  margin-bottom: 24rpx;
  line-height: 1.7;
}

.due {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.due-num {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--accent);
}

.chars {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}
.char-card {
  position: relative;
  width: calc((100% - 72rpx) / 4);
  height: 0;
  padding-bottom: calc((100% - 72rpx) / 4);
  box-sizing: border-box;
  background-color: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
}
.char-card.due {
  border-color: var(--accent);
}
.char {
  position: absolute;
  left: 0;
  right: 0;
  top: 24rpx;
  text-align: center;
  font-size: 60rpx;
  font-family: "Songti SC", serif;
}
.cnt {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 12rpx;
  text-align: center;
  font-size: 20rpx;
}
.del {
  position: absolute;
  top: 0;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  color: var(--accent);
  font-size: 34rpx;
}
.empty {
  text-align: center;
  padding: 60rpx 0;
}
.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}
.actions .btn {
  flex: 1;
}
