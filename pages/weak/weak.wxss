.tip {
  margin-bottom: 24rpx;
  line-height: 1.7;
}
.chars {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}
.char-card {
  position: relative;
  width: calc((100% - 72rpx) / 4);
  height: 0;
  padding-bottom: calc((100% - 72rpx) / 4);
  box-sizing: border-box;
}
.char {
  position: absolute;
  left: 0;
  right: 0;
  top: 24rpx;
  text-align: center;
  font-size: 60rpx;
  font-family: "Songti SC", serif;
}
.cnt {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 12rpx;
  text-align: center;
  font-size: 20rpx;
}
.del {
  position: absolute;
  top: 0;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  color: #b23a33;
  font-size: 34rpx;
}
.empty {
  text-align: center;
  padding: 60rpx 0;
}
.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}
.actions .btn {
  flex: 1;
}
