.head {
  padding: 16rpx 8rpx 32rpx;
}
.head-name {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}
.grid-item {
  width: calc(50% - 12rpx);
  box-sizing: border-box;
}
.grid-name {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.grid-desc {
  margin-top: 10rpx;
  color: #8a8578;
  font-size: 24rpx;
}
.grid-count {
  margin-top: 22rpx;
  color: #b23a33;
  font-size: 22rpx;
}
.btn.block {
  margin-top: 40rpx;
}
