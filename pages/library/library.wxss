.head {
  padding: 16rpx 8rpx 32rpx;
}
.head-name {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}
.grid-item {
  width: calc(50% - 12rpx);
  box-sizing: border-box;
}
.grid-name {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.grid-desc {
  margin-top: 10rpx;
  color: #8a8578;
  font-size: 24rpx;
}
.grid-count {
  margin-top: 22rpx;
  color: #b23a33;
  font-size: 22rpx;
}
.btn.block {
  margin-top: 40rpx;
}

.grades {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.grade-row {
  display: flex;
  align-items: center;
}
.grade-no {
  width: 120rpx;
  flex-shrink: 0;
  color: #8a8578;
  font-size: 26rpx;
}
.grade-books {
  display: flex;
  gap: 16rpx;
}
.book-chip {
  padding: 14rpx 34rpx;
  border-radius: 12rpx;
  border: 1rpx solid #e7e0d0;
  background-color: #fdfbf5;
  font-size: 28rpx;
}
