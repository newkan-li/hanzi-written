.quiz {
  display: flex;
  flex-direction: column;
}
.bar {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
}
.prompt-main.pinyin {
  font-size: 72rpx;
  color: var(--accent);
  letter-spacing: 4rpx;
}
.prompt-main.char {
  font-size: 140rpx;
  font-family: "Songti SC", serif;
}
.tip {
  margin-top: 20rpx;
}

.options {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 32rpx;
}
.option {
  width: calc(50% - 12rpx);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  border: 1rpx solid var(--border);
  background-color: var(--card);
}
.option.big {
  height: 200rpx;
  font-size: 96rpx;
  font-family: "Songti SC", serif;
}
.option.text {
  height: 120rpx;
  font-size: 40rpx;
  color: var(--ink);
}
.option.right {
  border-color: #2f8f4e;
  background-color: rgba(47, 143, 78, 0.12);
}
.option.wrong {
  border-color: var(--accent);
  background-color: rgba(178, 58, 51, 0.12);
}

.feedback {
  margin-top: 28rpx;
  text-align: center;
  font-size: 30rpx;
}
.ok {
  color: #2f8f4e;
}
.no {
  color: var(--accent);
}
.btn.block {
  margin-top: 28rpx;
}

.result {
  margin-top: 40rpx;
  text-align: center;
  padding: 48rpx 32rpx;
}
.result-score {
  font-size: 96rpx;
  font-weight: 700;
  color: var(--accent);
}
.wrong-title {
  margin: 32rpx 0 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: left;
}
.wrong-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.wrong-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  background-color: var(--input);
}
.wrong-char {
  font-size: 44rpx;
  font-family: "Songti SC", serif;
}
.result-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}
.result-actions .btn {
  flex: 1;
}
