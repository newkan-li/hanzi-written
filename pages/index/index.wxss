.hero {
  padding: 20rpx 8rpx 36rpx;
}
.hero-title {
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
}
.hero-sub {
  margin-top: 8rpx;
  color: #8a8578;
  font-size: 26rpx;
}

.search {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
}
.search-input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  background-color: #f4efe3;
  border-radius: 38rpx;
  font-size: 28rpx;
}

.daily {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #fdfbf5 0%, #f1ead9 100%);
}
.daily-tip {
  margin-top: 16rpx;
  color: #8a8578;
  font-size: 24rpx;
}
.daily-char {
  font-size: 140rpx;
  line-height: 1;
  color: #2b2b2b;
  font-family: "Songti SC", serif;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}.grid-item {
  width: calc(50% - 12rpx);
  box-sizing: border-box;
}
.grid-name {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.grid-desc {
  margin-top: 10rpx;
  color: #8a8578;
  font-size: 24rpx;
}
.grid-count {
  margin-top: 22rpx;
  color: #b23a33;
  font-size: 22rpx;
}

.quick {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 24rpx;
}
.quick-item {
  flex: 1 1 calc(50% - 12rpx);
  box-sizing: border-box;
  padding: 28rpx;
}
.quick-name {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}

.lesson {
  margin-top: 24rpx;
}
.lesson-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.lesson-title {
  font-size: 40rpx;
  font-family: "Songti SC", serif;
  margin: 12rpx 0 6rpx;
}
.lesson-go {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  background-color: #b23a33;
  color: #fff;
  font-size: 26rpx;
}
.lesson-chars {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}
.lchar {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  border: 1rpx solid #e7e0d0;
  background-color: #fff;
  font-size: 40rpx;
  font-family: "Songti SC", serif;
}

.grades {
  margin-top: 24rpx;
}.grades-label {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.grades-scroll {
  white-space: nowrap;
}
.grade {
  display: inline-block;
  padding: 14rpx 30rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  border: 1rpx solid #d8cfb8;
  background-color: #fdfbf5;
  color: #8a8578;
  font-size: 26rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}
.chip {
  width: 92rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  border: 1rpx solid #e7e0d0;
  background-color: #fdfbf5;
  font-size: 46rpx;
  font-family: "Songti SC", serif;
}

.poemcard {
  margin-top: 24rpx;
}
.poem-title {
  font-size: 38rpx;
  font-family: "Songti SC", serif;
  margin: 12rpx 0 6rpx;
}
.poem-line {
  margin-top: 16rpx;
  font-size: 30rpx;
  letter-spacing: 3rpx;
  color: #2b2b2b;
  font-family: "Songti SC", serif;
}

.card-links {
  display: flex;
  justify-content: flex-end;
  gap: 32rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #efe9da;
}
.link {
  color: #b23a33;
  font-size: 26rpx;
}
