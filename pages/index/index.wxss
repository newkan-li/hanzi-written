.hero {
  padding: 20rpx 8rpx 36rpx;
}
.hero-title {
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
}
.hero-sub {
  margin-top: 8rpx;
  color: #8a8578;
  font-size: 26rpx;
}

.search {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
}
.search-input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  background-color: #f4efe3;
  border-radius: 38rpx;
  font-size: 28rpx;
}

.daily {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #fdfbf5 0%, #f1ead9 100%);
}
.daily-tip {
  margin-top: 16rpx;
  color: #8a8578;
  font-size: 24rpx;
}
.daily-char {
  font-size: 140rpx;
  line-height: 1;
  color: #2b2b2b;
  font-family: "Songti SC", serif;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}.grid-item {
  width: calc(50% - 12rpx);
  box-sizing: border-box;
}
.grid-name {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.grid-desc {
  margin-top: 10rpx;
  color: #8a8578;
  font-size: 24rpx;
}
.grid-count {
  margin-top: 22rpx;
  color: #b23a33;
  font-size: 22rpx;
}

.quick {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}
.quick-item {
  flex: 1;
  padding: 28rpx;
}
.quick-name {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}
