<view class="page">
  <view class="hero">
    <view class="hero-title">墨学</view>
    <view class="hero-sub">跟着笔顺，写好每一个汉字</view>
  </view>

  <view class="search card">
    <input
      class="search-input"
      placeholder="输入汉字，如：永"
      value="{{query}}"
      confirm-type="search"
      bindinput="onInput"
      bindconfirm="onSearch"
    />
    <view class="btn" bindtap="onSearch">搜索</view>
  </view>

  <view class="daily card" bindtap="onPracticeDaily">
    <view class="daily-info">
      <view class="tag">每日一字</view>
      <view class="daily-tip">点一点，跟写今天的字</view>
    </view>
    <view class="daily-char">{{daily}}</view>
  </view>

  <view class="lesson card" wx:if="{{dailyLesson}}">
    <view class="lesson-head">
      <view>
        <view class="tag">今日一课</view>
        <view class="lesson-title">{{dailyLesson.title}}</view>
        <view class="muted">{{dailyLesson.bookName}} · {{dailyLesson.kind}}</view>
      </view>
      <view class="lesson-go" bindtap="onPracticeLesson">练这一课</view>
    </view>
    <view class="lesson-chars">
      <view
        class="lchar"
        wx:for="{{dailyLesson.chars}}"
        wx:key="*this"
        data-char="{{item}}"
        bindtap="onTapChar"
      >{{item}}</view>
    </view>
  </view>

  <view class="grades">
    <view class="grades-label">教材同步</view>
    <scroll-view scroll-x class="grades-scroll" enable-flex>
      <view
        class="grade"
        wx:for="{{books}}"
        wx:key="id"
        data-book="{{item.id}}"
        bindtap="onOpenTextbook"
      >{{item.short}}</view>
    </scroll-view>
  </view>

  <view class="quick">
    <view class="quick-item card" bindtap="onOpenTextbook">
      <view class="quick-name">教材同步</view>
      <view class="muted">1-6 年级生字</view>
    </view>
    <view class="quick-item card" bindtap="onWorksheet">
      <view class="quick-name">生成字帖</view>
      <view class="muted">选字排版打印</view>
    </view>
    <view class="quick-item card" bindtap="onIdiom">
      <view class="quick-name">成语练字</view>
      <view class="muted">拼音与释义</view>
    </view>
    <view class="quick-item card" bindtap="onScribe">
      <view class="quick-name">自由书写</view>
      <view class="muted">临摹练习轨迹</view>
    </view>
  </view>

  <block wx:if="{{recent.length}}">
    <view class="section-title">最近练习</view>
    <view class="chips">
      <view
        class="chip"
        wx:for="{{recent}}"
        wx:key="*this"
        data-char="{{item}}"
        bindtap="onTapChar"
      >{{item}}</view>
    </view>
  </block>

  <view class="section-title">字库分类</view>
  <view class="grid">
    <view
      class="grid-item card"
      wx:for="{{categories}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onOpenCategory"
    >
      <view class="grid-name">{{item.name}}</view>
      <view class="grid-desc">{{item.desc}}</view>
      <view class="grid-count">{{item.chars.length}} 字</view>
    </view>
  </view>
</view>
