.search {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}
.search-input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  background-color: var(--input);
  border-radius: 38rpx;
  font-size: 28rpx;
}

.hint {
  margin-bottom: 16rpx;
}

.chars {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}
.c {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  border: 1rpx solid var(--border);
  background-color: var(--card);
  font-size: 50rpx;
  font-family: "Songti SC", serif;
}

.empty {
  text-align: center;
  padding: 60rpx 0;
}
