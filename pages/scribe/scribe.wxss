.scribe {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tools-row {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.guide-input {
  width: 140rpx;
  height: 68rpx;
  padding: 0 20rpx;
  background-color: var(--input);
  border-radius: 34rpx;
  font-size: 30rpx;
  text-align: center;
}
.tool {
  flex: 1;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 34rpx;
  border: 1rpx solid var(--border2);
  color: var(--muted);
  font-size: 26rpx;
  background-color: var(--card);
}
.tool.active {
  border-color: var(--accent);
  background-color: var(--accent);
  color: #fff;
}

.board {
  padding: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.scribe-canvas {
  display: block;
  background-color: var(--card);
  border-radius: 8rpx;
}

.swatch {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
  box-sizing: border-box;
}
.swatch.active {
  border-color: var(--accent);
}
.width {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 1rpx solid var(--border2);
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--card);
}
.width.active {
  border-color: var(--accent);
}
.dot {
  border-radius: 50%;
}

.actions {
  width: 100%;
  display: flex;
  gap: 20rpx;
}
.actions .btn {
  flex: 1;
}
.hint {
  margin-top: 24rpx;
  text-align: center;
}
