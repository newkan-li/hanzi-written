.stats {
  display: flex;
  justify-content: space-around;
  text-align: center;
}
.stat {
  flex: 1;
}
.stat-num {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--accent);
}

.day {
  margin-bottom: 20rpx;
}
.day-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.day-label {
  font-size: 30rpx;
  font-weight: 600;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.chip {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  border: 1rpx solid var(--border);
  background-color: var(--card);
  font-size: 40rpx;
  font-family: "Songti SC", serif;
}

.empty {
  text-align: center;
  padding: 60rpx 0;
}
