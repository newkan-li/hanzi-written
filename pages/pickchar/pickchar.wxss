.pick {
  padding-bottom: 140rpx;
}
.tabs {
  display: flex;
  border: 1rpx solid #e7e0d0;
  border-radius: 40rpx;
  overflow: hidden;
  background-color: #fdfbf5;
  margin-bottom: 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #8a8578;
}
.tab.active {
  background-color: #b23a33;
  color: #fff;
}

.chips-row {
  white-space: nowrap;
  margin-bottom: 20rpx;
}
.chip {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  border: 1rpx solid #d8cfb8;
  background-color: #fdfbf5;
  color: #8a8578;
  font-size: 26rpx;
}
.chip.active {
  border-color: #b23a33;
  background-color: #b23a33;
  color: #fff;
}

.custom-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.custom-input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  background-color: #f4efe3;
  border-radius: 38rpx;
  font-size: 28rpx;
}

.chars {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}
.c {
  position: relative;
  width: 92rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  border: 1rpx solid #e7e0d0;
  background-color: #fdfbf5;
  font-size: 46rpx;
  font-family: "Songti SC", serif;
}
.c.on {
  border-color: #b23a33;
  background-color: #b23a33;
  color: #ffffff;
}
.c.on::after {
  content: "✓";
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  background-color: #2f8f4e;
  color: #fff;
  font-size: 22rpx;
}

.empty {
  text-align: center;
  padding: 40rpx 0;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background-color: #fdfbf5;
  border-top: 1rpx solid #e7e0d0;
}
.bar-info {
  font-size: 28rpx;
  color: #8a8578;
}
.strong {
  color: #b23a33;
  font-weight: 600;
}
.bar-actions {
  display: flex;
  gap: 16rpx;
}
.btn.small {
  height: 68rpx;
  padding: 0 36rpx;
}
