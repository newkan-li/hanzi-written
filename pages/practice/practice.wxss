.practice {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.meta {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.progress {
  color: #8a8578;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}
.fav {
  padding: 8rpx 26rpx;
  border-radius: 30rpx;
  border: 1rpx solid #d8cfb8;
  color: #8a8578;
  font-size: 24rpx;
}
.fav.active {
  border-color: #b23a33;
  color: #b23a33;
}

.stage {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  padding: 12rpx;
}
/* 田字格背景（用背景绘制，保证在画布之下） */
.stage.with-grid {
  background-image:
    linear-gradient(rgba(178, 58, 51, 0.22), rgba(178, 58, 51, 0.22)),
    linear-gradient(rgba(178, 58, 51, 0.22), rgba(178, 58, 51, 0.22)),
    linear-gradient(to right, rgba(178, 58, 51, 0.16) 1rpx, transparent 1rpx),
    linear-gradient(to bottom, rgba(178, 58, 51, 0.16) 1rpx, transparent 1rpx);
  background-size: 100% 1rpx, 1rpx 100%, 50% 50%, 50% 50%;
  background-position: center center;
  background-repeat: no-repeat, no-repeat, repeat, repeat;
}

.loading,
.error {
  position: absolute;
  color: #8a8578;
  font-size: 26rpx;
}
.error {
  color: #b23a33;
  padding: 0 40rpx;
  text-align: center;
}

.modes {
  display: flex;
  margin: 36rpx 0 8rpx;
  border: 1rpx solid #e7e0d0;
  border-radius: 40rpx;
  overflow: hidden;
  background-color: #fdfbf5;
}
.mode {
  padding: 16rpx 48rpx;
  font-size: 28rpx;
  color: #8a8578;
}
.mode.active {
  background-color: #b23a33;
  color: #fff;
}

.toolbar {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 36rpx;
}

.footer {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 36rpx;
}
