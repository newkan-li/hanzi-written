<view class="page practice">
  <view class="meta">
    <view class="progress">第 {{index + 1}} / {{total}} 字</view>
    <view class="fav {{isFav ? 'active' : ''}}" bindtap="toggleFav">
      {{isFav ? '已收藏' : '收藏'}}
    </view>
  </view>

  <view class="note card" wx:if="{{note}}">
    <view class="note-title">{{note.title}}</view>
    <view class="muted">{{note.desc}}</view>
  </view>

  <view class="stage card {{gridStyle === 'none' ? '' : 'with-grid grid-' + gridStyle}}">
    <hanzi-writer-view id="hz-writer" width="{{size}}" height="{{size}}" />
    <view class="loading" wx:if="{{loading}}">字库加载中…</view>
    <view class="error" wx:if="{{error}}">{{error}}</view>
  </view>

  <view class="modes">
    <view
      class="mode {{mode === item.key ? 'active' : ''}}"
      wx:for="{{modes}}"
      wx:key="key"
      data-mode="{{item.key}}"
      bindtap="switchMode"
    >{{item.name}}</view>
  </view>

  <view class="grids">
    <view class="grid-label">格子</view>
    <view
      class="grid-chip {{gridStyle === item.key ? 'active' : ''}}"
      wx:for="{{gridStyles}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onSelectGrid"
    >{{item.name}}</view>
  </view>

  <view class="toolbar">
    <view class="btn ghost" data-delta="-1" bindtap="go">上一个</view>
    <view class="btn" bindtap="replay">再写一遍</view>
    <view class="btn ghost" data-delta="1" bindtap="go">下一个</view>
  </view>

  <view class="toolbar second">
    <view class="btn ghost" bindtap="speak">朗读</view>
    <view class="btn ghost" bindtap="makePoster">海报</view>
    <view class="btn ghost" bindtap="makeWorksheet">字帖</view>
  </view>

  <view class="info card">
    <view class="info-title">
      <text class="info-char">{{char}}</text>
      <text class="info-pinyin">{{info ? info.pinyin : ''}}</text>
    </view>
    <view class="info-grid">
      <view class="info-item"><text class="k">部首</text><text>{{info ? info.radical : '—'}}</text></view>
      <view class="info-item"><text class="k">笔画</text><text>{{info ? info.strokes : '—'}}</text></view>
      <view class="info-item"><text class="k">结构</text><text>{{info ? info.structure : '—'}}</text></view>
    </view>
    <view class="info-line">
      <text class="k">组词</text>
      <view class="word-chips">
        <view
          class="word-chip"
          wx:for="{{info.words}}"
          wx:key="*this"
          data-word="{{item}}"
          bindtap="onWordTap"
        >{{item}}</view>
      </view>
    </view>
    <view class="info-line"><text class="k">释义</text><text>{{info.meaning}}</text></view>
  </view>

  <view class="footer">
    <view class="muted">已练 {{practiced}} 次</view>
  </view>
</view>
