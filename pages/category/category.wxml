<view class="page">
  <view class="head">
    <view class="head-name">{{name}}</view>
    <view class="muted">{{desc}} · 共 {{totalChars}} 字</view>
  </view>

  <view class="chars">
    <view
      class="char-card"
      wx:for="{{chars}}"
      wx:key="*this"
      data-char="{{item}}"
      bindtap="onTapChar"
    >
      <view class="char">{{item}}</view>
      <view class="grid-lines"></view>
    </view>
  </view>

  <view class="pager" wx:if="{{totalPages > 1}}">
    <view class="pg {{hasPrev ? '' : 'disabled'}}" bindtap="prev">上一页</view>
    <view class="pg-info">{{page + 1}} / {{totalPages}}</view>
    <view class="pg {{hasNext ? '' : 'disabled'}}" bindtap="next">下一页</view>
  </view>
</view>
