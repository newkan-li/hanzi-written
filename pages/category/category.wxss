.head {
  padding: 16rpx 8rpx 32rpx;
}
.head-name {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.chars {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}
.char-card {
  position: relative;
  width: calc((100% - 72rpx) / 4);
  height: 0;
  padding-bottom: calc((100% - 72rpx) / 4);
  background-color: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  overflow: hidden;
}
.char {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
  font-size: 64rpx;
  color: var(--ink);
  font-family: "Songti SC", serif;
}
/* 田字格辅助线 */
.grid-lines::before,
.grid-lines::after {
  content: "";
  position: absolute;
  background-color: rgba(178, 58, 51, 0.18);
}
.grid-lines::before {
  left: 0;
  right: 0;
  top: 50%;
  height: 1rpx;
}
.grid-lines::after {
  top: 0;
  bottom: 0;
  left: 50%;
  width: 1rpx;
}

.pager {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  margin: 48rpx 0 20rpx;
}
.pg {
  padding: 16rpx 44rpx;
  border-radius: 40rpx;
  background-color: var(--accent);
  color: #fff;
  font-size: 28rpx;
}
.pg.disabled {
  background-color: var(--border);
  color: var(--muted-soft);
}
.pg-info {
  color: var(--muted);
  font-size: 28rpx;
}

/* 古诗一首一页 */
.poem {
  padding: 40rpx 32rpx;
}
.poem-title {
  font-size: 44rpx;
  font-family: "Songti SC", serif;
}
.poem-meta {
  margin: 10rpx 0 28rpx;
}
.lines {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.line {
  display: flex;
  flex-wrap: wrap;
}
.pchar {
  font-size: 40rpx;
  line-height: 1.6;
  letter-spacing: 6rpx;
  font-family: "Songti SC", serif;
  color: var(--ink);
}
.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}
.actions .btn {
  flex: 1;
}
