/* 全局主题：宣纸米色 + 墨色 + 朱红 */
page {
  background-color: #f7f4ec;
  color: #2b2b2b;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Songti SC", serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
}

.card {
  background-color: #fdfbf5;
  border: 1rpx solid #e7e0d0;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(43, 43, 43, 0.05);
  padding: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin: 40rpx 0 20rpx;
  letter-spacing: 2rpx;
}

.muted {
  color: #8a8578;
  font-size: 24rpx;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 36rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background-color: #b23a33;
  color: #fff;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

.btn.ghost {
  background-color: transparent;
  color: #b23a33;
  border: 1rpx solid #b23a33;
}

.btn.block {
  display: flex;
  width: 100%;
}

.tag {
  display: inline-block;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
  background-color: #efe9da;
  color: #8a8578;
  font-size: 22rpx;
}
