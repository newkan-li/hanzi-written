/* 全局主题变量（浅色） */
page {
  --bg: #f7f4ec;
  --card: #fdfbf5;
  --input: #f4efe3;
  --line: #efe9da;
  --border: #e7e0d0;
  --border2: #d8cfb8;
  --ink: #2b2b2b;
  --muted: #8a8578;
  --muted-soft: #b7b0a2;
  --accent: #b23a33;
  --tag-bg: #efe9da;
  --shadow: rgba(43, 43, 43, 0.05);

  background-color: var(--bg);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Songti SC", serif;
  font-size: 28rpx;
  line-height: 1.6;
}

@media (prefers-color-scheme: dark) {
  page {
    --bg: #161616;
    --card: #222222;
    --input: #2c2c2c;
    --line: #333333;
    --border: #3a3a3a;
    --border2: #4a4a4a;
    --ink: #e8e6e0;
    --muted: #9a9a92;
    --muted-soft: #6a6a62;
    --accent: #d05a52;
    --tag-bg: #2c2c2c;
    --shadow: rgba(0, 0, 0, 0.35);
  }
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
}

.card {
  background-color: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx var(--shadow);
  padding: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin: 40rpx 0 20rpx;
  letter-spacing: 2rpx;
}

.muted {
  color: var(--muted);
  font-size: 24rpx;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 36rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background-color: var(--accent);
  color: #fff;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

.btn.ghost {
  background-color: transparent;
  color: var(--accent);
  border: 1rpx solid var(--accent);
}

.btn.block {
  display: flex;
  width: 100%;
}

.tag {
  display: inline-block;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
  background-color: var(--tag-bg);
  color: var(--muted);
  font-size: 22rpx;
}
