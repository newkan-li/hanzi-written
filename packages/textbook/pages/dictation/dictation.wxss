.dic {
  display: flex;
  flex-direction: column;
}
.bar {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
}
.pinyin {
  font-size: 72rpx;
  color: #b23a33;
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
}
.btn.small {
  height: 64rpx;
  padding: 0 40rpx;
}
.tip {
  margin-top: 20rpx;
}

.options {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 32rpx;
}
.option {
  width: calc(50% - 12rpx);
  box-sizing: border-box;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  border: 1rpx solid #e7e0d0;
  background-color: #fdfbf5;
  font-size: 96rpx;
  font-family: "Songti SC", serif;
}
.option.right {
  border-color: #2f8f4e;
  background-color: rgba(47, 143, 78, 0.12);
}
.option.wrong {
  border-color: #b23a33;
  background-color: rgba(178, 58, 51, 0.12);
}

.feedback {
  margin-top: 28rpx;
  text-align: center;
  font-size: 30rpx;
}
.ok {
  color: #2f8f4e;
}
.no {
  color: #b23a33;
}

.result {
  margin-top: 60rpx;
  text-align: center;
  padding: 60rpx 32rpx;
}
.result-score {
  font-size: 96rpx;
  font-weight: 700;
  color: #b23a33;
}
.result-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}
.result-actions .btn {
  flex: 1;
}
